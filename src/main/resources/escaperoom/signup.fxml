<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.SignupController">

    <!-- TOP: toolbar automatically sticks across the top -->
    <top>
        <ToolBar prefHeight="63.0" style="-fx-background-color: transparent;">
            <items>
                <Button mnemonicParsing="false" onMouseClicked="#back" text="Back" />
                <Button mnemonicParsing="false" onMouseClicked="#settings" style="-fx-background-color: black;" text="Settings" />
            </items>
        </ToolBar>
    </top>

    <!-- CENTER: content centered in the window -->
    <center>
        <StackPane id="StackPane" fx:id="signup_pane" alignment="CENTER">
            <children>
                <VBox alignment="CENTER" prefWidth="600" spacing="20" style="-fx-padding: 40;">
                    <children>

                        <Label style="-fx-background-color: #0099ff; -fx-label-padding: 10px; -fx-background-radius: 5px;" text="Sign Up">
                            <font>
                                <Font size="30.0" />
                            </font>
                        </Label>

                        <!-- Username + password row -->
                        <HBox alignment="CENTER" spacing="10">
                            <children>
                                <Label style="-fx-background-color: #0099ff; -fx-label-padding: 5px; -fx-background-radius: 2px;" text="Username:" />
                                <TextField fx:id="txt_username" promptText="username...." style="-fx-background-color: white;" />

                                <Label style="-fx-background-color: #0099ff; -fx-label-padding: 5px; -fx-background-radius: 2px;" text="Password:" />
                                <TextField fx:id="txt_password" promptText="password..." style="-fx-background-color: white;" />
                            </children>
                        </HBox>
                  <Label style="-fx-label-padding: 5px; -fx-background-color: cc9900; -fx-background-radius: 2px;" text="Username must have 4+ characters.&#10;Password must have 8+ characters and 1+ number(s)." />

                        <Label fx:id="lbl_error" prefHeight="60.0" prefWidth="180.0" style="-fx-background-radius: 2px; -fx-font-size: 10px;" />
                          <Button mnemonicParsing="false" onAction="#onLoginClicked" prefHeight="50.0" prefWidth="219.0" style="-fx-background-color: navy;" text="Sign Up" />
                  <HBox alignment="CENTER" spacing="20" />

                        <HBox alignment="CENTER" spacing="20">
                            <children>
                                <Label style="-fx-label-padding: 5px; -fx-background-color: cc9900; -fx-background-radius: 2px;" text="Have an account?" />
      
                              <Button mnemonicParsing="false" onMouseClicked="#btnSignupClicked" prefHeight="24.0" prefWidth="173.0" style="-fx-background-color: navy;" text="Login" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>
