<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.DifficultyController"
            stylesheets="@styles.css">

    <!-- TOP: toolbar -->
    <top>
        <ToolBar prefHeight="63.0">
            <items>
                <Button mnemonicParsing="false"
                        onMouseClicked="#back"
                        text="Back" />
                   <Button mnemonicParsing="false"
                        onMouseClicked="#settings"
                        style="-fx-background-color: black;"
                        text="Settings" />
            </items>
        </ToolBar>
    </top>

    <!-- CENTER: centered settings card -->
    <center>
        <StackPane id="StackPane" fx:id="difficulty_pane" alignment="CENTER">
            <children>
                <VBox spacing="20.0"
                      alignment="CENTER"
                      prefWidth="600.0"
                      style="-fx-padding: 40;">
                    <children>

                        <!-- Title -->
                        <Label text="Select Difficulty"
                               style="-fx-background-color: #0099ff; -fx-label-padding: 10px; -fx-background-radius: 5px;">
                            <font>
                                <Font size="30.0" />
                            </font>
                        </Label>

                       
                        <VBox spacing="10.0" alignment="CENTER">
                            <children>
                              <Button mnemonicParsing="false"
                                onMouseClicked="#easy"
                                prefHeight="24.0"
                                prefWidth="173.0"
                                style="-fx-background-color: green"
                                text="Easy"/>

                                 <Button mnemonicParsing="false"
                                onMouseClicked="#medium"
                                prefHeight="24.0"
                                prefWidth="173.0"
                                style="-fx-background-color: #ffcc00"
                                text="Medium"/>

                                 <Button mnemonicParsing="false"
                                onMouseClicked="#hard"
                                prefHeight="24.0"
                                prefWidth="173.0"
                                style="-fx-background-color: red"
                                text="Hard"/>
                               
                            </children>
                        </VBox>

                        
                       

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
    <bottom>
      <StackPane fx:id="guestWarningBar"
             alignment="CENTER"
             visible="false"
             managed="false"
             style="-fx-padding: 10 0 20 0;">
        <children>
        <HBox spacing="10.0"
         alignment="CENTER"
        >
            <Label text = "! As a Guest, progress won't be saved! Create Account?">
               <font>
                  <Font size="12.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false"
                    onAction="#onSignupClicked"
                    prefHeight="20.0"
                    prefWidth="173.0"
                    style="-fx-background-color: green"
                    text="Sign Up" />
         </HBox>
         </children>
      </StackPane>
   </bottom>
</BorderPane>
