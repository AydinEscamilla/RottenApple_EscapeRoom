<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ToolBar?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.SignupController"
            stylesheets="@styles.css">

    <!-- TOP: toolbar automatically sticks across the top -->
    <top>
        <ToolBar prefHeight="63.0">
            <items>
                <Button mnemonicParsing="false"
                        onMouseClicked="#back"
                        text="Back" />
                <Button mnemonicParsing="false"
                        onMouseClicked="#settings"
                        style="-fx-background-color: black;"
                        text="Settings" />
            </items>
        </ToolBar>
    </top>

    <!-- CENTER: content centered in the window -->
    <center>
        <StackPane id="StackPane" fx:id="signup_pane" alignment="CENTER">
            <children>
                <VBox spacing="20" alignment="CENTER"
                      prefWidth="600"
                      style="-fx-padding: 40;">
                    <children>

                        <Label text="Sign Up"
                               style="-fx-background-color: #0099ff; -fx-label-padding: 10px; -fx-background-radius: 5px;">
                            <font>
                                <Font size="30.0" />
                            </font>
                        </Label>

                        <!-- Username + password row -->
                        <HBox spacing="10" alignment="CENTER">
                            <children>
                                <Label text="Username:"
                                       style="-fx-background-color: #0099ff; -fx-label-padding: 5px; -fx-background-radius: 2px;" />
                                <TextField fx:id="txt_username"
                                           promptText="username...."
                                           style="-fx-background-color: white;" />

                                <Label text="Password:"
                                       style="-fx-background-color: #0099ff; -fx-label-padding: 5px; -fx-background-radius: 2px;" />
                                <TextField fx:id="txt_password"
                                           promptText="password..."
                                           style="-fx-background-color: white;" />
                            </children>
                        </HBox>

                        <Label fx:id="lbl_error"
                               prefHeight="60.0"
                               prefWidth="180.0"
                               style="-fx-background-radius: 2px; -fx-font-size: 10px;" />

                        <Button mnemonicParsing="false"
                                onMouseClicked="#btnSignupClicked"
                                prefHeight="24.0"
                                prefWidth="173.0"
                                style="-fx-background-color: navy;"
                                text="Login" />

                        <HBox spacing="20" alignment="CENTER">
                            <children>
                                <Label text="Have an account?"
                                       style="-fx-label-padding: 5px; -fx-background-color: cc9900; -fx-background-radius: 2px;" />
                                <Button mnemonicParsing="false"
                                        onAction="#onLoginClicked"
                                        prefHeight="50.0"
                                        prefWidth="219.0"
                                        style="-fx-background-color: navy;"
                                        text="Sign Up" />
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>