<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" fx:id="pause_pane" prefHeight="200.0" prefWidth="300.0" style="-fx-background-color: #2b2b2b; -fx-background-radius: 10; -fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
   
   <children>
    <Label layoutX="112.0" layoutY="7.0" style="-fx-text-fill: white; -fx-font-size: 24px;" text="Paused" />
        <Button layoutX="121.0" layoutY="87.0" onAction="#handleResume" text="Resume" />
        <Button layoutX="105.0" layoutY="132.0" onAction="#handleSaveQuit" text="Save and Quit" />
    
   </children>
</AnchorPane>
